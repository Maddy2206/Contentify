# ── Existing ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (server-only — never use NEXT_PUBLIC_ for DB URLs)
DRIZZLE_DB_URL=
# Legacy name kept for backward-compat during migration; prefer DRIZZLE_DB_URL
NEXT_PUBLIC_DRIZZLE_DB_URL=

# Clerk authentication keys (from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Gemini API key — primary AI model (from https://aistudio.google.com/apikey)
# Model used: gemini-2.5-flash
GEMINI_API_KEY=

# Groq API key — fallback on 429 / 503 from Gemini (from https://console.groq.com)
# Model used: meta-llama/llama-4-maverick-17b-128e-instruct (generation)
#             meta-llama/llama-4-scout-17b-16e-instruct (repurpose)
GROQ_API_KEY=

# ── Phase 1 ───────────────────────────────────────────────────────────────────
# AES-256-GCM key used to encrypt OAuth tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Phase 3 ───────────────────────────────────────────────────────────────────
# Your deployed app URL — no trailing slash. Used to build OAuth callback URLs.
NEXT_PUBLIC_APP_URL=https://yourapp.vercel.app

# LinkedIn OAuth credentials (from https://www.linkedin.com/developers/apps)
# Required permissions: Share on LinkedIn + Sign In with LinkedIn using OpenID Connect
# Redirect URL to register: ${NEXT_PUBLIC_APP_URL}/api/social/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Phase 4 ───────────────────────────────────────────────────────────────────
# Bearer token that Vercel Cron sends to authenticate the publish endpoint.
# Generate with: openssl rand -hex 16
CRON_SECRET=
